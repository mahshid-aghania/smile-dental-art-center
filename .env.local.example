# Replicate (required for /api/generate-smile)
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Replicate model slug (default: black-forest-labs/flux-kontext-max)
REPLICATE_MODEL=black-forest-labs/flux-kontext-max

# Formspree — create forms at https://formspree.io and paste each form ID (the part after /f/)
# Appointment request (homepage + /appointments)
NEXT_PUBLIC_FORMSPREE_APPOINTMENT_ID=

# Contact page (/contact-us)
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=

# AI smile preview patient intake (submitted after successful generation)
NEXT_PUBLIC_FORMSPREE_PATIENT_INTAKE_ID=
